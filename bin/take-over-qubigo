#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  printf 'Usage: %s [SOURCE [DESTINATION]]\n' "${0##*/}"
  printf 'Copy factory run docs (not application code) for sharing.\n'
  printf 'Defaults: %s/q -> %s/qubigo\n' "$repo_root" "$repo_root"
  printf 'Preserves docs/ and .assembly-lines/ layout, including hidden files.\n'
  printf 'Existing files are updated; unrelated or removed files are not deleted.\n'
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac
if (( $# > 2 )); then
  usage >&2
  exit 2
fi

source="${1:-$repo_root/q}"
destination="${2:-$repo_root/qubigo}"
items=(docs/vision.md docs/backlog.md docs/iterations .assembly-lines)

# Validate everything before creating or updating the snapshot.
source="$(cd "$source" && pwd -P)"
for item in "${items[@]}"; do
  if [[ ! -e "$source/$item" ]]; then
    printf 'Missing source: %s\n' "$source/$item" >&2
    exit 1
  fi
done
# Do not export symlinks, which could expose files outside the selected docs.
if [[ -n "$(find "${items[@]/#/$source/}" -type l -print -quit)" ]]; then
  printf 'Source docs contain a symlink; refusing to export it.\n' >&2
  exit 1
fi

destination="$(realpath -m -- "$destination")"
case "$destination/" in
  "$source/"*) printf 'Destination must be outside the source.\n' >&2; exit 1 ;;
esac
case "$source/" in
  "$destination/"*) printf 'Destination must not contain the source.\n' >&2; exit 1 ;;
esac
# Avoid writing through symlinks in an existing snapshot.
if [[ -d "$destination" ]] && [[ -n "$(find "$destination" -type l -print -quit)" ]]; then
  printf 'Destination contains a symlink; refusing to overwrite through it.\n' >&2
  exit 1
fi

mkdir -p "$destination/docs/iterations" "$destination/.assembly-lines"
cp -- "$source/docs/vision.md" "$source/docs/backlog.md" "$destination/docs/"
cp -R -- "$source/docs/iterations/." "$destination/docs/iterations/"
cp -R -- "$source/.assembly-lines/." "$destination/.assembly-lines/"
printf 'Copied factory run docs to %s\n' "$destination"
printf 'Review the snapshot for private information before publishing.\n'
