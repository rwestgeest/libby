digraph assembly_line {
  start -> plan_initializer
  plan_initializer -> design_walkthrough [label="not complete"]
  design_walkthrough -> plan_revision
  plan_initializer -> planner [label="complete"]
  planner -> finish [label="complete"]
  planner -> design_walkthrough [label="needs_design_discussion"]
  planner -> doer [label="not needs_design_discussion"]
  plan_revision -> plan_reviewer_1
  plan_revision -> plan_reviewer_2
  plan_revision -> plan_reviewer_3
  plan_reviewer_1 -> plan_consensus
  plan_reviewer_2 -> plan_consensus
  plan_reviewer_3 -> plan_consensus
  plan_consensus -> plan_revision [label="not satisfied"]
  plan_consensus -> doer [label="satisfied"]
  doer -> rdd_validator
  rdd_validator -> doer [label="not satisfied"]
  rdd_validator -> planner [label="satisfied"]
}
