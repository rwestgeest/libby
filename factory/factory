#!/usr/bin/env bash
set -euo pipefail
factory_dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
mvn -q -f "$factory_dir/pom.xml" compile dependency:build-classpath \
  -Dmdep.includeScope=runtime -Dmdep.outputFile="$factory_dir/target/runtime-classpath.txt"
exec java -cp "$factory_dir/target/classes:$(cat "$factory_dir/target/runtime-classpath.txt")" MainKt "$@"
