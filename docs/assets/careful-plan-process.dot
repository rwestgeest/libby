digraph careful_plan {
  graph [rankdir=TB, bgcolor="#ffffff", pad="0.35", nodesep="0.5", ranksep="0.6", fontname="sans-serif", label="Careful plan: discuss design choices, then implement incrementally", labelloc=t, fontsize=20]
  node [shape=box, style="rounded,filled", fillcolor="#edf2f7", color="#94a3b8", fontname="sans-serif", fontsize=13, margin="0.18,0.12"]
  edge [fontname="sans-serif", fontsize=11, color="#475569", arrowsize=0.75]
  start [label="Start / explicit rerun", shape=oval]
  plan_initializer [label="Initial planner\nCreate or read capability outline", fillcolor="#e7effc", URL="../careful-plan-process.md#plan-initializer", tooltip="plan_initializer: instructions and role"]
  design_walkthrough [label="Design walkthrough (gpt-6.1-sol:medium)\nInitial sketch or new design choice", fillcolor="#fff2cd", color="#b8860b", URL="../careful-plan-process.md#design-walkthrough", tooltip="design_walkthrough: instructions and role"]
  plan_revision [label="Revise current capability\nHonor discussion decisions", fillcolor="#e7effc", URL="../careful-plan-process.md#plan-revision", tooltip="plan_revision: instructions and role"]
  plan_reviewer_1 [label="Reviewer 1\nOpenAI", fillcolor="#e7effc", URL="../careful-plan-process.md#plan-reviewer-1", tooltip="plan_reviewer_1: instructions and role"]
  plan_reviewer_2 [label="Reviewer 2\nAnthropic", fillcolor="#e7effc", URL="../careful-plan-process.md#plan-reviewer-2", tooltip="plan_reviewer_2: instructions and role"]
  plan_reviewer_3 [label="Reviewer 3\nGoogle", fillcolor="#e7effc", URL="../careful-plan-process.md#plan-reviewer-3", tooltip="plan_reviewer_3: instructions and role"]
  plan_consensus [label="All three approve\nthe same plan?", shape=diamond, fillcolor="#e7effc", URL="../careful-plan-process.md#plan-consensus", tooltip="plan_consensus: instructions and role"]
  doer [label="Doer\nTest-drive current capability", fillcolor="#e3f4e7", URL="../careful-plan-process.md#doer", tooltip="doer: instructions and role"]
  rdd_validator [label="OO / RDD validator\nAccept this implementation?", shape=diamond, fillcolor="#e3f4e7", URL="../careful-plan-process.md#rdd-validator", tooltip="rdd_validator: instructions and role"]
  planner [label="Planner\nRecord completion; assess next task", fillcolor="#e3f4e7", URL="../careful-plan-process.md#planner", tooltip="planner: instructions and role"]
  finish [label="Finish", shape=oval, fillcolor="#e3f4e7"]
  {rank=same; plan_reviewer_1; plan_reviewer_2; plan_reviewer_3}
  start -> plan_initializer
  plan_initializer -> design_walkthrough [label="not complete"]
  design_walkthrough -> plan_revision
  plan_initializer -> planner [label="complete"]
  planner -> finish [label="complete"]
  planner -> design_walkthrough [label="needs_design_discussion"]
  planner -> doer [label="not needs_design_discussion"]
  plan_revision -> plan_reviewer_1
  plan_revision -> plan_reviewer_2
  plan_revision -> plan_reviewer_3
  plan_reviewer_1 -> plan_consensus
  plan_reviewer_2 -> plan_consensus
  plan_reviewer_3 -> plan_consensus
  plan_consensus -> plan_revision [label="not satisfied"]
  plan_consensus -> doer [label="satisfied"]
  doer -> rdd_validator
  rdd_validator -> doer [label="not satisfied"]
  rdd_validator -> planner [label="satisfied"]
}
